# Auth.js / NextAuth
# In production this MUST be the public URL of the site, e.g. https://revisionbee.com
AUTH_URL=http://localhost:3000
AUTH_SECRET=

# Google OAuth
# Create credentials here: https://console.cloud.google.com/apis/credentials
# Add /api/auth/callback/google as an Authorized redirect URI (use the live domain).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft/Outlook OAuth
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0/

# Firebase Cloud Messaging > Project Settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Optional override for the backend endpoint that returns Netless room credentials.
NEXT_PUBLIC_WHITEBOARD_SESSION_URL=https://ankitadev.parastechnologies.in/admin.revisionbee.com/api/v1/lesson/session/whiteboard
